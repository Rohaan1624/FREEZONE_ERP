# Copy to .env and fill in with your own Supabase project's values:
#   cp .env.example .env
#
# Both are read at BUILD time by Vite and end up in the browser bundle, so
# neither is a secret — the publishable/anon key is designed to be public.
# What actually protects your data is Row Level Security, which is why every
# table in backend/schema.sql has it enabled.
#
# NEVER put the service_role key here. It bypasses RLS entirely, and anything
# prefixed VITE_ is shipped to every visitor.
#
# Vite only reads .env at startup — restart `npm run dev` after editing it.

# Project Settings -> Data API -> Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Project Settings -> API Keys -> publishable / anon key
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# ── Asistente (apagado) ──────────────────────────────────────────────────────
# La cuota de Groq es POR ORGANIZACIÓN, no por cuenta: unas 93 preguntas al día
# repartidas entre TODOS los inquilinos. Con más de una empresa usándolo, la
# primera que pregunte deja sin cupo a las demás.
#
# Para encenderlo hacen falta LAS DOS cosas — esta, y el secreto del servidor:
#   supabase secrets set ASISTENTE_ACTIVO=1
# Solo esta esconde la pestaña pero no cierra la función; solo la otra cierra
# la función pero deja una pestaña que falla.
VITE_ASISTENTE=0
